{
  "name": "find-in-everything",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension to search selected text with Everything HTTP Server",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "build:store": "tsc --noEmit && vite build --mode store",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/chrome": "^0.0.326",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "lucide": "^1.25.0"
  }
}
